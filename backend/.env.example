# Use production only behind HTTPS and after replacing every placeholder.
APP_ENV=development
MONGODB_URI=mongodb://localhost:27017
DB_NAME=chaska
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=chaska-api
JWT_AUDIENCE=chaska-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_ACTIVE_SESSIONS=5
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Enable only behind a proxy that replaces client-supplied forwarding headers.
TRUST_PROXY_HEADERS=false
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional one-time admin bootstrap. Configure both together, start once, then remove both.
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SAMESITE=lax

# Optional online payments. Production requires live keys and a webhook secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
